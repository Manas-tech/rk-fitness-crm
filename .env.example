# Database connection URL (SQLite default for self-contained, zero-setup local dev/production)
# Can also be PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="file:./dev.db"

# JWT secret for authentication session cookies
JWT_SECRET="replace_with_a_secure_random_string_in_production"

# App Public Information
NEXT_PUBLIC_APP_NAME="IronPulse Gym CRM"
